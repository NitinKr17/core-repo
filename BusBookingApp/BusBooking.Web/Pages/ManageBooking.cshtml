@page "{id:int}"
@model BusBooking.Web.Pages.ManageBookingModel
@using BusBooking.Shared.Constants
@{
    Layout = "_Layout";
    ViewData["Title"] = "Manage Booking";
    var successMessage = TempData[AppConstants.SuccessMessageKey]?.ToString();
    var errorMessage = TempData[AppConstants.ErrorMessageKey]?.ToString();
}

<h3 class="mb-3">Manage Booking</h3>

@if (Model.Booking is null)
{
    <div class="alert alert-warning">Unable to load booking.</div>
}
else
{
    <div class="card mb-3">
        <div class="card-body">
            <div><strong>Bus:</strong> @Model.Booking.Bus?.OperatorName</div>
            <div><strong>Route:</strong> @Model.Booking.Bus?.Source → @Model.Booking.Bus?.Destination</div>
            <div><strong>Departure:</strong> @Model.Booking.Bus?.DepartureTime.ToString("g")</div>
            <div><strong>Seats Left:</strong> @Model.Booking.Bus?.AvailableSeats / @Model.Booking.Bus?.TotalSeats</div>
        </div>
    </div>

    @if (Model.Booking?.Bus?.DepartureTime > DateTime.UtcNow)
    {
        <div class="card border-danger mb-3">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="card-title text-danger mb-1">Cancel booking</h6>
                    <small class="text-muted">Cancelling will free all reserved seats.</small>
                </div>
                <form method="post" asp-page-handler="Cancel" 
                        asp-route-id="@Model.Id" asp-route-bookingId="@Model.Booking?.Id"
                        onsubmit="return confirm('Cancel this booking? This cannot be undone.');">
                    <button class="btn btn-outline-danger">Cancel Booking</button>
                </form>
            </div>
        </div>
    }

    <h5>Passengers</h5>
    <table class="table table-sm align-middle">
        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Age</th>
                <th>Gender</th>
                <th style="width:110px;"></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Booking.Passengers?.Any() == true)
            {
                foreach (var p in Model.Booking.Passengers)
                {
                    <tr>
                        <td>@p.Name</td>
                        <td>@p.Age</td>
                        <td>@p.Gender</td>
                        <td class="text-end">
                            <form method="post" asp-page-handler="Remove"
                                  asp-route-id="@Model.Id" asp-route-passengerId="@p.Id">
                                <input type="hidden" name="cancelIfLast" value="false" />
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        onclick="confirmRemove(this.form, @((Model.Booking.Passengers!.Count == 1).ToString().ToLower()))">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="4" class="text-muted">No passengers</td></tr>
            }
        </tbody>
    </table>

    <!-- Add passenger form -->
    @if (Model.Booking.Bus?.DepartureTime > DateTime.UtcNow)
    {
        <form method="post" asp-page-handler="Add" asp-route-id="@Model.Id">
            <div class="row g-2">
                <div class="col">
                    <input asp-for="PassengerName" class="form-control" placeholder="Name" />
                    <span asp-validation-for="PassengerName" class="text-danger"></span>
                </div>
                <div class="col">
                    <input asp-for="PassengerAge" type="number" class="form-control" />
                    <span asp-validation-for="PassengerAge" class="text-danger"></span>
                </div>
                <div class="col">
                    <select asp-for="PassengerGender" class="form-select">
                        <option value="">-- Select --</option>
                        <option>Male</option>
                        <option>Female</option>
                    </select>
                    <span asp-validation-for="PassengerGender" class="text-danger"></span>
                </div>
                <div class="col-auto">
                    <button class="btn btn-sm btn-primary">Add</button>
                </div>
            </div>
        </form>
    }
}

<!-- Toast container -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
    <div id="toastMessage" class="toast align-items-center text-white bg-success border-0"
         role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="toastContent"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto"
                    data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function confirmRemove(form, isLast) {
            const msg = isLast
                ? "This is the only passenger in this booking. Removing it will cancel the entire booking. Continue?"
                : "Remove this passenger?";
            if (confirm(msg)) {
                if (isLast) form.cancelIfLast.value = "true";
                form.submit();
            }
        }

        function showToast(message, isError = false) {
            const toastEl = document.getElementById('toastMessage');
            const toastContent = document.getElementById('toastContent');

            toastContent.textContent = message;
            toastEl.classList.remove('bg-success', 'bg-danger');
            toastEl.classList.add(isError ? 'bg-danger' : 'bg-success');

            const toast = new bootstrap.Toast(toastEl);
            toast.show();

            if (!isError && message.includes("Booking cancelled")) {
                setTimeout(() => {
                    window.location.href = '/Booking';
                }, 3000);
            }
        }

        window.addEventListener('DOMContentLoaded', () => {
            const successMessage = '@successMessage';
            const errorMessage = '@errorMessage';

            if (successMessage || errorMessage) {
                showToast((successMessage || errorMessage), !successMessage);
            }
        });
    </script>
}
