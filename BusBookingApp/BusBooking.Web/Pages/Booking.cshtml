@page
@model BusBooking.Web.Pages.BookingModel
@using BusBooking.Shared.Constants
@{
    ViewData["Title"] = "Booking";
    var successMessage = TempData[AppConstants.SuccessMessageKey]?.ToString();
    var errorMessage = TempData[AppConstants.ErrorMessageKey]?.ToString();
}

<h2 class="mb-4">Passenger Details</h2>

<form id="bookingForm" method="post">
    <input type="hidden" name="BusId" value="@Model.BusId" />

    <table class="table table-bordered" id="passengerTable">
        <thead class="table-light text-center">
            <tr>
                <th>Name</th>
                <th>Age</th>
                <th>Gender</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody id="passengerBody">
            <!-- Dynamic rows will be inserted here -->
        </tbody>
        <tfoot>
            <tr>
                <td><input type="text" id="name" class="form-control" /></td>
                <td><input type="number" id="age" class="form-control" /></td>
                <td>
                    <select id="gender" class="form-control">
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                    </select>
                </td>
                <td>
                    <button type="button" class="btn btn-primary" onclick="addPassenger()">Add</button>
                </td>
            </tr>
        </tfoot>
    </table>

    <input type="hidden" name="PassengersJson" id="PassengersJson" />
    <button type="submit" class="btn btn-success">Confirm Booking</button>
</form>

<!-- Toast container -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
    <div id="toastMessage" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="toastContent"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let passengers = [];

        function renderPassengers() {
            const tbody = document.getElementById('passengerBody');
            tbody.innerHTML = '';
            passengers.forEach((p, index) => {
                tbody.innerHTML += `
                    <tr>
                        <td>${p.Name}</td>
                        <td>${p.Age}</td>
                        <td>${p.Gender}</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-warning" onclick="editPassenger(${index})">Edit</button>
                            <button type="button" class="btn btn-sm btn-danger" onclick="deletePassenger(${index})">Delete</button>
                        </td>
                    </tr>`;
            });
            document.getElementById('PassengersJson').value = JSON.stringify(passengers);
        }

        function addPassenger() {
            const name = document.getElementById('name').value.trim();
            const age = document.getElementById('age').value.trim();
            const gender = document.getElementById('gender').value;

            if (!name || !age || !gender) {
                showToast('Please enter all fields.', true);
                return;
            }

            passengers.push({ Name: name, Age: parseInt(age), Gender: gender });
            clearForm();
            renderPassengers();
        }

        function deletePassenger(index) {
            passengers.splice(index, 1);
            renderPassengers();
        }

        function editPassenger(index) {
            const p = passengers[index];
            document.getElementById('name').value = p.Name;
            document.getElementById('age').value = p.Age;
            document.getElementById('gender').value = p.Gender;
            deletePassenger(index);
        }

        function clearForm() {
            document.getElementById('name').value = '';
            document.getElementById('age').value = '';
            document.getElementById('gender').value = 'Male';
        }

        function showToast(message, isError = false) {
            const toastEl = document.getElementById('toastMessage');
            const toastContent = document.getElementById('toastContent');

            toastContent.textContent = message;
            toastEl.classList.remove('bg-success', 'bg-danger');
            toastEl.classList.add(isError ? 'bg-danger' : 'bg-success');

            const toast = new bootstrap.Toast(toastEl);
            toast.show();

            if (!isError) {
                setTimeout(() => {
                    window.location.href = '/Home/Index';
                }, 2000);
            }
        }

        window.addEventListener('DOMContentLoaded', () => {
            const successMessage = '@successMessage';
            const errorMessage = '@errorMessage';

            if (successMessage || errorMessage) {
                showToast(successMessage || errorMessage, !successMessage);
            }
        });
    </script>
}
