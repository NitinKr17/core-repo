@page
@model BusBooking.Web.Pages.Admin.BusesModel
@using BusBooking.Shared.Constants
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Buses";

    var successMessage = TempData[AppConstants.SuccessMessageKey]?.ToString();
    var errorMessage = TempData[AppConstants.ErrorMessageKey]?.ToString();
}

<div class="card shadow-sm mb-4">
    <div class="card-header fw-semibold text-center">Add New Bus</div>
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="OperatorName" class="form-label">Operator</label>
                    <input asp-for="OperatorName" class="form-control" />
                    <span asp-validation-for="OperatorName" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="Source" class="form-label">From</label>
                    <input asp-for="Source" class="form-control" />
                    <span asp-validation-for="Source" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="Destination" class="form-label">To</label>
                    <input asp-for="Destination" class="form-control" />
                    <span asp-validation-for="Destination" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="DepartureTime" class="form-label">Departure</label>
                    <input asp-for="DepartureTime" type="datetime-local" class="form-control" />
                    <span asp-validation-for="DepartureTime" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="ArrivalTime" class="form-label">Arrival</label>
                    <input asp-for="ArrivalTime" type="datetime-local" class="form-control" />
                    <span asp-validation-for="ArrivalTime" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="TotalSeats" class="form-label">Total Seats</label>
                    <input asp-for="TotalSeats" type="number" min="1" class="form-control" />
                    <span asp-validation-for="TotalSeats" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="AvailableSeats" class="form-label">Available Seats</label>
                    <input asp-for="AvailableSeats" type="number" min="0" class="form-control" />
                    <span asp-validation-for="AvailableSeats" class="text-danger"></span>
                </div>

                <div class="col-12 text-center">
                    <button type="submit" class="btn btn-primary">Create Bus</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- All Buses (full width, below) -->
<div class="card shadow-sm">
    <div class="card-header fw-semibold text-center">All Buses</div>
    <div class="card-body p-0">
        @if (Model.Buses is { Count: > 0 })
        {
            <div class="table-responsive">
                <table class="table table-bordered text-center">
                    <thead class="table-light">
                        <tr class="align-middle">
                            <th rowspan="2">#</th>
                            <th rowspan="2">Operator</th>
                            <th colspan="2">Route</th>
                            <th colspan="2">Departure</th>
                            <th colspan="2">Arrival</th>
                            <th colspan="2">Seats</th>
                            <th rowspan="2">Bookings</th>
                        </tr>
                        <tr class="align-middle">
                            <th>From</th>
                            <th>To</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Available</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Buses.Count; i++)
                        {
                            var b = Model.Buses[i];
                            <tr>
                                <td>@(i + 1)</td>
                                <td>@b.OperatorName</td>
                                <td>@b.Source</td>
                                <td>@b.Destination</td>
                                <td>@b.DepartureTime.ToString("dd-MM-yyyy")</td>
                                <td>@b.DepartureTime.ToString("HH:mm")</td>
                                <td>@b.ArrivalTime.ToString("dd-MM-yyyy")</td>
                                <td>@b.ArrivalTime.ToString("HH:mm")</td>
                                <td>@b.AvailableSeats</td>
                                <td>@b.TotalSeats</td>
                                <td class="text-end">
                                    <a asp-page="/Admin/Bookings" asp-route-busId="@b.Id" class="btn btn-sm btn-outline-secondary">
                                        See bookings
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-3 text-muted">No buses found.</div>
        }
    </div>
</div>

<!-- Toast container -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
    <div id="toastMessage" class="toast align-items-center text-white bg-success border-0"
         role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="toastContent"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto"
                    data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
         (function ($) {
          $.validator.addMethod("availnotgt", function (value, element, params) {
            var $other = $(element.form).find("[name='" + params.other.replace("*.", "") + "']");
            var v = parseFloat(value), o = parseFloat($other.val());
            if (isNaN(v) || isNaN(o)) return true;
            return v <= o;
          });

          $.validator.unobtrusive.adapters.add("availnotgt", ["other"], function (options) {
            options.rules["availnotgt"] = { other: options.params.other };
            options.messages["availnotgt"] = options.message;

            var otherName = options.params.other.replace("*.", "");
            var $other = $(options.element.form).find("[name='" + otherName + "']");
            $other.on("input change", function () {
              $(options.element).valid();
            });
          });
        })(jQuery);

        function showToast(message, isError = false) {
            const toastEl = document.getElementById('toastMessage');
            const toastContent = document.getElementById('toastContent');

            toastContent.textContent = message;
            toastEl.classList.remove('bg-success', 'bg-danger');
            toastEl.classList.add(isError ? 'bg-danger' : 'bg-success');

            const toast = new bootstrap.Toast(toastEl);
            toast.show();
        }

        window.addEventListener('DOMContentLoaded', () => {
            const successMessage = '@successMessage';
            const errorMessage   = '@errorMessage';

            if (successMessage || errorMessage) {
                showToast(successMessage || errorMessage, !successMessage);
            }
        });
    </script>
}
