@page
@model BusBooking.Web.Pages.Home.IndexModel
@{
    ViewData["Title"] = "Search Buses";
}

<h2>Search Buses</h2>

<form id="searchForm" class="row g-3 align-items-end">
    <div class="col-md-4">
        <label for="from" class="form-label">From</label>
        <input type="text" name="from" id="from" class="form-control" required />
    </div>
    <div class="col-md-4">
        <label for="to" class="form-label">To</label>
        <input type="text" name="to" id="to" class="form-control" required />
    </div>
    <div class="col-md-3">
        <label for="date" class="form-label">Date</label>
        <input type="date" name="date" id="date" class="form-control" required />
    </div>
    <div class="col-md-1">
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

<hr />
<div id="searchResults"></div>

@section Scripts {
    <script>
        document.getElementById("searchForm").addEventListener("submit", async function (e) {
            e.preventDefault();
            const formData = new FormData(this);
            const params = new URLSearchParams(formData);

            const response = await fetch(`/Home/Index?handler=Search&${params.toString()}`);
            const html = await response.text();
            document.getElementById("searchResults").innerHTML = html;
        });
    </script>
}
